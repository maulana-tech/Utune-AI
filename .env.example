NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
DATABASE_URL="postgres://postgres.xxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Gunakan Upstash Redis URL di sini
REDIS_URL="rediss://default:your-password@your-upstash-endpoint.upstash.io:6379"

# Encrypts workspace API keys saved in Settings → API keys (BYOK). Any long random
# string; must be identical for web and workers. Changing it makes saved keys unreadable.
SECRETS_KEY=""

# Lead sources (server defaults — each workspace can override these in Settings → API keys)
GOOGLE_MAPS_API_KEY="AIza..."             # required by the `places` source (Google Places API)
COMPOSIO_API_KEY="comp_..."               # required by the `apollo` source — https://app.composio.dev
COMPOSIO_USER_ID=""                       # optional; defaults to the workspace id (per-workspace Apollo connection)
APIFY_TOKEN="apify_api_..."               # required by the `apify` source — https://console.apify.com/settings/integrations
APIFY_ACTOR_ID=""                         # optional; defaults to compass/crawler-google-places
# Social posts (source "social"/"twitter"/"threads"/"linkedin") also use APIFY_TOKEN; actors overridable:
# APIFY_TWITTER_ACTOR / APIFY_THREADS_ACTOR / APIFY_LINKEDIN_ACTOR
# Reddit posts use COMPOSIO_API_KEY + a Reddit account connected in Composio
FIRECRAWL_API_KEY="fc-..."                # required by the `firecrawl` source — https://firecrawl.dev/app/api-keys
OUTSCRAPER_API_KEY=""                     # `outscraper` source — https://app.outscraper.com/profile
SERPAPI_API_KEY=""                        # `serpapi` source — https://serpapi.com/manage-api-key
FOURSQUARE_API_KEY=""                     # `foursquare` source (service key) — https://foursquare.com/developers
HERE_API_KEY=""                           # `here` source — https://platform.here.com
TOMTOM_API_KEY=""                         # `tomtom` source — https://developer.tomtom.com
YELP_API_KEY=""                           # `yelp` source — https://www.yelp.com/developers
OVERPASS_URL=""                           # optional; pin one Overpass instance (default: public instances with fallback)

# Website contact enrichment (leads with a website but no email/phone).
# Free HTTP crawl always runs first; these paid layers only touch sites still empty.
CAMOFOX_URL=""                            # optional self-hosted camofox-browser (`npx @askjo/camofox-browser`, port 9377) — free JS rendering
CAMOFOX_ENRICH_MAX="30"                   # max sites per job rendered by camofox
FIRECRAWL_ENRICH_MAX="20"                 # max sites per job rendered by Firecrawl (uses FIRECRAWL_API_KEY above)
SGAI_API_KEY=""                           # ScrapeGraphAI v2 (LLM extraction on their side) — https://dashboard.scrapegraphai.com
SGAI_ENRICH_MAX="10"                      # max sites per job; ~5 credits each
# Source "auto" (the default) tries every source whose key is set, in that order,
# then falls back to keyless OpenStreetMap (overpass, then osm). Empty key = skipped.

# AI Keys
NVIDIA_API_KEY="nvapi-..."
SUMOPOD_API_KEY="sk-..."                  # https://sumopod.com/dashboard/ai/quickstart
GOOGLE_API_KEY="..."                      # https://aistudio.google.com/apikey
ANTHROPIC_API_KEY="sk-ant-..."            # optional, for Claude

# Email sending — EMAIL_PROVIDER picks one (packages/db/src/mailer.ts):
#   "gmail"  (default) the workspace's Gmail, connected in Composio (uses COMPOSIO_API_KEY)
#   "resend" RESEND_API_KEY + RESEND_FROM_EMAIL on a verified domain; open/click tracking via webhook
#   "smtp"   SumoPod SMTP below ("sumopod" also accepted)
EMAIL_PROVIDER="gmail"

# Resend (API-based, supports webhooks & tracking)
RESEND_API_KEY="re_..."                   # https://resend.com/api-keys
RESEND_FROM_EMAIL="hello@yourdomain.com"  # Must be a verified domain in Resend
RESEND_WEBHOOK_SECRET="whsec_..."         # From Resend webhook settings (for signature verification)

# SumoPod (SMTP-based, simple but no tracking)
SUMOPOD_SMTP_HOST="smtp.sumopod.com"
SUMOPOD_SMTP_PORT="465"
SUMOPOD_SMTP_USER="your_username"
SUMOPOD_SMTP_PASS="your_password"
SUMOPOD_FROM_EMAIL="sender@example.com"

# Model overrides per tier (optional — defaults: fast=8b, standard=70b, heavy=claude)
# Supports provider:model syntax: nvidia:meta/llama-3.1-8b, google:gemma-4-31b-it, sumopod:gpt-4o, claude-sonnet-4-6
# AI_FAST_MODEL="google:gemma-4-26b-a4b-it"
# AI_STANDARD_MODEL="nvidia:meta/llama-3.1-70b-instruct"
# AI_HEAVY_MODEL="claude-sonnet-4-6"
