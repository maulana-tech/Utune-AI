# ── Vercel env (web) ── Project → Settings → Environment Variables (Production).
# Paste these one by one; redeploy after changing any of them.
# Lines marked REQUIRED must be set.

# Supabase (Project Settings → API)   REQUIRED
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Same database as the VPS — pages read it directly   REQUIRED
DATABASE_URL=""

# The API on the VPS, server-side only (no NEXT_PUBLIC_)   REQUIRED
API_URL="https://api.your-domain.com"
# Identical to the VPS values   REQUIRED
API_SECRET=""
SECRETS_KEY=""

# Email — the Contacts "Send email" button runs on Vercel, so it needs the same email config
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
GMAIL_COMPOSIO_API_KEY=""
EMAIL_BRAND_NAME=""
EMAIL_BRAND_URL=""
EMAIL_BRAND_FOOTER=""
EMAIL_CTA_URL=""

# Resend → Webhooks → signing secret ("whsec_…"); without it the webhook is rejected in production
RESEND_WEBHOOK_SECRET=""
