# ── VPS .env (API + worker) ── copy to ~/app/.env, fill in, chmod 600.
# Lines marked REQUIRED must be set; the rest can stay empty.

NODE_ENV=production

# Database (Supabase → Project Settings → Database → Connection pooling URI)   REQUIRED
DATABASE_URL=""
# Redis: Upstash "rediss://default:...@...upstash.io:6379", or "redis://localhost:6379" with --redis   REQUIRED
REDIS_URL=""

# Shared secrets — identical values on VPS and Vercel. Generate: openssl rand -base64 36   REQUIRED
API_SECRET=""
SECRETS_KEY=""

# Web domains allowed to call the API (comma-separated)
ALLOWED_ORIGINS="https://your-web.vercel.app"

# ── Email ──
EMAIL_PROVIDER="resend"                   # resend | gmail | smtp
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""                      # "Name <hello@your-verified-domain.com>"
GMAIL_COMPOSIO_API_KEY=""                 # only for EMAIL_PROVIDER=gmail
EMAIL_BRAND_NAME=""
EMAIL_BRAND_URL=""
EMAIL_BRAND_FOOTER=""
EMAIL_CTA_URL=""                          # booking link for {{cta_url}} buttons

# ── Lead sources (server defaults; workspaces can add their own in Settings → API keys) ──
COMPOSIO_API_KEY=""                       # Apollo + Reddit
APIFY_TOKEN=""                            # X, Threads, LinkedIn posts; Apify Google Maps
FIRECRAWL_API_KEY=""
SGAI_API_KEY=""
GOOGLE_MAPS_API_KEY=""
OUTSCRAPER_API_KEY=""
SERPAPI_API_KEY=""
FOURSQUARE_API_KEY=""
HERE_API_KEY=""
TOMTOM_API_KEY=""
YELP_API_KEY=""

# ── AI (email drafts, lead analysis, AI Query) ──
NVIDIA_API_KEY=""

# ── Optional ──
CAMOFOX_URL=""                            # "http://localhost:9377" if camofox runs in PM2
